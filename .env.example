# Copier en .env (ignoré par Git) et adapter
AWS_PROFILE=alexa
AWS_REGION=eu-west-1
FUNCTION_NAME=Home-Assistant
# Skill ID de la console développeur Alexa (amzn1.ask.skill.…)
SKILL_ID=
# Adresse publique de Home Assistant, sans / final
HA_URL=https://home.example.org
# Jeton HA longue durée, pour check.sh seulement
HA_TOKEN=
